{
  "name": "@lh-ui/vue2",
  "type": "module",
  "version": "0.0.0",
  "description": "lh-ui Vue 2.7 UI 组件库（企业级国风水墨设计），基于 @lh-ui/share 框架无关共享层",
  "main": "lib/index.js",
  "module": "es/index.js",
  "unpkg": "dist/lh-ui-vue2.umd.js",
  "jsdelivr": "dist/lh-ui-vue2.umd.js",
  "types": "es/index.d.ts",
  "exports": {
    ".": {
      "types": "./es/index.d.ts",
      "import": "./es/index.js",
      "require": "./lib/index.js"
    },
    "./lib": "./lib/index.js",
    "./es": "./es/index.js",
    "./dist": "./dist/lh-ui-vue2.umd.js",
    "./locale": {
      "types": "./es/locale/index.d.ts",
      "import": "./es/locale/index.js",
      "require": "./lib/locale/index.js"
    },
    "./theme": {
      "types": "./es/theme/index.d.ts",
      "import": "./es/theme/index.js",
      "require": "./lib/theme/index.js"
    },
    "./constants": {
      "types": "./es/constants/index.d.ts",
      "import": "./es/constants/index.js",
      "require": "./lib/constants/index.js"
    },
    "./style/*": "./es/components/*/style/index.css",
    "./theme.css": "./dist/theme/index.css",
    "./theme-dark.css": "./dist/theme/index-dark.css"
  },
  "files": [
    "es",
    "lib",
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "build": "pnpm run build:esm && pnpm run build:cjs && pnpm run build:umd && pnpm run build:styles && pnpm run build:dts",
    "build:esm": "vite build --mode esm",
    "build:cjs": "vite build --mode cjs",
    "build:umd": "vite build --mode umd",
    "build:styles": "node scripts/build-styles.mjs",
    "build:dts": "tsc -p tsconfig.build.json",
    "verify:dts": "node scripts/verify-dts.mjs",
    "lint": "eslint src tests scripts dev docs/.vitepress vite.config.ts vitest.config.ts rollup.dts.config.js",
    "lint:fix": "eslint src tests scripts dev docs/.vitepress vite.config.ts vitest.config.ts rollup.dts.config.js --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "prepublishOnly": "pnpm run build",
    "dev": "vite --config dev/vite.config.ts",
    "build:demo": "vite build --config dev/vite.config.ts --mode demo && node scripts/copy-demo.mjs",
    "docs:dev": "pnpm --dir docs dev -port 5177",
    "docs:build": "pnpm --dir docs build",
    "docs:preview": "pnpm --dir docs preview"
  },
  "dependencies": {
    "@lh-ui/share": "link:../lh-ui-share"
  },
  "peerDependencies": {
    "vue": "^2.7.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.1",
    "@vitejs/plugin-vue2": "^2.3.3",
    "@vue/test-utils": "^1.3.6",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.9.7",
    "rollup": "^4.63.3",
    "rollup-plugin-dts": "^6.5.1",
    "sass": "^1.104.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^5.4.19",
    "vitest": "^2.1.9",
    "vue": "2.7.16"
  }
}
