{
  "name": "@lh-ui/vue2",
  "type": "module",
  "version": "1.0.0",
  "description": "lh-ui Vue 2.7 UI 组件库（企业级国风水墨设计），基于 @lh-ui/share 框架无关共享层",
  "license": "Apache-2.0",
  "keywords": [
    "lh-ui",
    "ui",
    "components",
    "component-library",
    "design-system",
    "theme",
    "vue",
    "vue2",
    "chinese-style"
  ],
  "homepage": "https://www.lhgb.top/lhui/vue2/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lh-ui/lh-ui-vue2.git"
  },
  "bugs": {
    "url": "https://github.com/lh-ui/lh-ui-vue2/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "lib/index.js",
  "module": "es/index.js",
  "unpkg": "dist/lh-ui-vue2.umd.js",
  "jsdelivr": "dist/lh-ui-vue2.umd.js",
  "types": "es/index.d.ts",
  "exports": {
    ".": {
      "types": "./es/index.d.ts",
      "import": "./es/index.js",
      "require": "./lib/index.js"
    },
    "./lib": "./lib/index.js",
    "./es": "./es/index.js",
    "./dist": "./dist/lh-ui-vue2.umd.js",
    "./locale": {
      "types": "./es/locale/index.d.ts",
      "import": "./es/locale/index.js",
      "require": "./lib/locale/index.js"
    },
    "./theme": {
      "types": "./es/theme.d.ts",
      "import": "./es/theme.js",
      "require": "./lib/theme.js"
    },
    "./constants": {
      "types": "./es/constants.d.ts",
      "import": "./es/constants.js",
      "require": "./lib/constants.js"
    },
    "./style/*": "./es/components/*/style/index.css",
    "./theme.css": "./dist/theme/index.css",
    "./theme-dark.css": "./dist/theme/index-dark.css"
  },
  "files": [
    "es",
    "lib",
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "build": "pnpm run build:esm && pnpm run build:cjs && pnpm run build:umd && pnpm run build:styles && pnpm run build:dts",
    "build:esm": "vite build --mode esm",
    "build:cjs": "vite build --mode cjs",
    "build:umd": "vite build --mode umd",
    "build:styles": "node scripts/build-styles.mjs",
    "build:dts": "tsc -p tsconfig.build.json",
    "build:local": "node scripts/link-local-share.mjs && pnpm build",
    "verify:dts": "node scripts/verify-dts.mjs",
    "lint": "eslint src tests scripts dev docs/.vuepress docs/scripts vite.config.ts vitest.config.ts rollup.dts.config.js",
    "lint:fix": "eslint src tests scripts dev docs/.vuepress docs/scripts vite.config.ts vitest.config.ts rollup.dts.config.js --fix",
    "typecheck": "node scripts/gen-dev-tsconfig.mjs && tsc -p tsconfig.dev.json --noEmit",
    "typecheck:npm": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "prepublishOnly": "pnpm run build && pnpm run verify:dts",
    "dev": "vite --config dev/vite.config.ts",
    "gen:demo-code": "node scripts/gen-demo-code.mjs",
    "verify:demo": "node scripts/gen-demo-code.mjs --check",
    "verify:docs-sync": "node scripts/verify-docs-sync.mjs",
    "docs:dev": "pnpm --dir docs dev --port 5177",
    "docs:build": "pnpm --dir docs build",
    "docs:preview": "pnpm --dir docs preview",
    "docs:clean-cache": "pnpm --dir docs clean:cache"
  },
  "dependencies": {
    "@lh-ui/share": "^0.4.0"
  },
  "peerDependencies": {
    "vue": "^2.7.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue2": "^2.3.4",
    "@vue/test-utils": "^1.3.6",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.9.10",
    "rollup": "^4.64.5",
    "rollup-plugin-dts": "^6.5.1",
    "sass": "^1.105.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^5.4.21",
    "vitest": "^2.1.9",
    "vue": "2.7.16"
  }
}
